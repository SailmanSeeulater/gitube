# The Umami website ID for gitube.latesailor.dev (stats.latesailor.dev). It is not a secret:
# the built page carries it for anyone to read. Find it in Umami under Websites, then Edit on the
# site (on older versions Settings, then Websites, then Edit), and copy the Website ID.
# While it is empty, analytics stays off: no tracker is loaded and nothing is sent.
# Never set VITE_UMAMI_DOMAINS here: it is for checking a local build only (README, "Analytics"),
# and the live site would count nothing.
VITE_UMAMI_WEBSITE_ID=641003b5-473a-4804-84d7-6279b14d73e3
